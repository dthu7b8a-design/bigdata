# Reference only: set these environment variables locally before guest.ps1.
# This template is not loaded automatically. Never commit real guest credentials.
VMRUN_PATH=C:/path/to/VMware/vmrun.exe
VMX_PATH=C:/path/to/existing-ubuntu.vmx
VM_GUEST_USER=replace_with_guest_user
VM_GUEST_PASSWORD=replace_with_local_guest_password
EVCHARGE_WEBHDFS=http://replace_with_private_vm_ip:9870
